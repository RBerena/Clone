{
  "expo": {
    "name": "AuthApp",
    "slug": "AuthApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "authapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "plugins": [
      [
        "@reactvision/react-viro",
        { "android": { "xRMode": "AR" } }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],

    "android": {
      "package": "com.authapp",
      "permissions": ["CAMERA"],
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "ios": {
      "bundleIdentifier": "com.authapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for AR features.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use your microphone"
      }
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "experiments": { "typedRoutes": true },

    "extra": {
      "router": {},
      "eas": { "projectId": "41da7f0b-ff3c-4d80-8e07-b24a4817590e" }
    }
  }
}
